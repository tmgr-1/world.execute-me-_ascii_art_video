{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "outDir": "dist", "rootDir": ".",
    "declaration": true, "sourceMap": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "films/**/*.ts", "test/**/*.ts"]
}
